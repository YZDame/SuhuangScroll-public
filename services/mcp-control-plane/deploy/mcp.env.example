# Copy this file to the host's protected environment file, for example:
#   /etc/suhuang-scroll/mcp.env
# Then replace every YOUR_* value before starting the service and run:
#   python scripts/release/check_mcp_deployment_config.py --env-file /path/to/mcp.env
# Keep the copied file mode 600. Never commit the copied file, access tokens, or
# OAuth client secrets.

HOST=127.0.0.1
PORT=8080
SUHUANG_LOG_EVENTS=1

# Public MCP resource metadata. The resource is the origin, not /mcp.
SUHUANG_MCP_RESOURCE=https://mcp.suhuangscroll.com
SUHUANG_RESOURCE_DOCUMENTATION=https://yzdame.github.io/SuhuangScroll-public/docs/

# Replace these with the values from one real OAuth 2.1/OIDC provider. The
# provider must publish authorization-server discovery, PKCE S256, an RS256
# JWKS, and access tokens with this audience and scope.
SUHUANG_OAUTH_ISSUER=https://YOUR_OIDC_ISSUER.example.com
SUHUANG_OAUTH_JWKS_URL=https://YOUR_OIDC_ISSUER.example.com/.well-known/jwks.json
SUHUANG_OAUTH_AUDIENCE=suhuang-mcp
SUHUANG_OAUTH_SCOPE=suhuang:runtime

# Use exact HTTPS origins when browser requests are expected. Leave unset only
# when all MCP calls come from server-side clients without an Origin header.
# SUHUANG_ALLOWED_ORIGINS=https://YOUR_CODEX_BROWSER_ORIGIN.example.com

# Generate a tenant-scoped Runtime agent token on the host. Do not use the
# same token for MCP users and the local Runtime agent.
SUHUANG_AGENT_TOKENS_JSON={"YOUR_AGENT_TOKEN":"YOUR_TENANT"}

# Optional, isolated reviewer fixture. Enable only in a review deployment and
# use a short-lived token that is not accepted by production user tenants.
# SUHUANG_MCP_REVIEW_MODE=fixture
# SUHUANG_MCP_REVIEW_TENANTS=codex-review
# SUHUANG_MCP_TOKENS_JSON={"YOUR_REVIEW_TOKEN":"codex-review"}

# Set this only after the OpenAI submission portal issues a domain challenge.
# SUHUANG_OPENAI_APPS_CHALLENGE=YOUR_PORTAL_CHALLENGE_TOKEN
