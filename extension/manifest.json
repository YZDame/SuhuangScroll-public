{
  "manifest_version": 3,
  "name": "Suhuang Scroll Bridge",
  "description": "Connect supported grading websites to the local Suhuang Scroll core.",
  "version": "0.6.4",
  "homepage_url": "https://github.com/YZDame/SuhuangScroll-public",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Suhuang Scroll Bridge"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.zhixue.com/*",
    "https://zhixue.com/*",
    "https://*.zhixue.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*.readboy.com/*",
    "https://dongni100.com/*",
    "https://*.dongni100.com/*",
    "http://dongni100.com/*",
    "http://*.dongni100.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhixue.com/*",
        "https://zhixue.com/*",
        "https://*.zhixue.com/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://*.readboy.com/*",
        "https://dongni100.com/*",
        "https://*.dongni100.com/*",
        "http://dongni100.com/*",
        "http://*.dongni100.com/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ]
}
