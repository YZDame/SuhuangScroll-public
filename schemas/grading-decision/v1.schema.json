{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YZDame/SuhuangScroll-public/blob/main/schemas/grading-decision/v1.schema.json",
  "title": "Suhuang Scroll Grading Decision v1",
  "description": "Normalized, reviewable model decision. It does not authorize score writeback.",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_id", "suggested_score", "confidence", "reason", "ocr_text"],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "suggested_score": {"type": "integer", "minimum": 0},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason": {"type": "string"},
    "ocr_text": {"type": "string"},
    "step_scores": {"type": "array", "items": {"$ref": "#/$defs/stepScore"}},
    "blank_scores": {"type": "array", "items": {"$ref": "#/$defs/blankScore"}},
    "model_diagnostics": {"anyOf": [{"$ref": "#/$defs/modelDiagnostics"}, {"type": "null"}]},
    "is_mock": {"type": ["boolean", "null"]}
  },
  "$defs": {
    "stepScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "score", "max_score"],
      "properties": {
        "step": {"type": "string"},
        "score": {"type": "integer", "minimum": 0},
        "max_score": {"type": "integer", "minimum": 0},
        "comment": {"type": ["string", "null"]},
        "student_answer": {"type": ["string", "null"]},
        "correct_answer": {"type": ["string", "null"]},
        "is_correct": {"type": ["boolean", "null"]}
      }
    },
    "blankScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blank_id", "score", "max_score"],
      "properties": {
        "blank_id": {"type": "string"},
        "score": {"type": "integer", "minimum": 0},
        "max_score": {"type": "integer", "minimum": 0},
        "extracted_answer": {"type": ["string", "null"]},
        "expected_answer": {"type": ["string", "null"]},
        "is_correct": {"type": ["boolean", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "modelDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider_id": {"type": ["string", "null"]},
        "model_id": {"type": ["string", "null"]},
        "response_parse_status": {"type": "string"},
        "normalization_adjustments": {"type": "array", "items": {"type": "string"}},
        "raw_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "normalized_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "response_latency_ms": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
